<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/assets/history.css?v=3">
    <title>Transaction History</title>
</head>

<body class="auth-page">

<nav class="top-nav">
    <a href="/cash/cashsidefrontend">Home</a>
    <a href="/logout">Logout</a>
</nav>

<section class="auth-form">
    <h2>Transaction History</h2>

    <div class="filter-row">
        <button class="filter-btn" data-filter="all">All</button>
        <button class="filter-btn" data-filter="cash">Cash</button>
        <button class="filter-btn" data-filter="invest">Investments</button>
    </div>

    <table class="history-table">
        <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Ticker</th>
            <th>Amount (£)</th>
        </tr>

        {{#each history}}
        <tr>
            <td>{{dateTime}}</td>
            <td>{{type}}</td>
            <td>{{ticker}}</td>
            <td class="amount-cell">{{amount}}</td>
        </tr>
        {{/each}}
    </table>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {

    // Convert pence → pounds
    function convert(selector) {
        document.querySelectorAll(selector).forEach(cell => {
            const raw = cell.textContent.trim();
            const pence = parseInt(raw || "0", 10);
            cell.textContent = (pence / 100).toFixed(2);
        });
    }
    convert('.amount-cell');

    // Filtering logic
    const rows = document.querySelectorAll('.history-table tr:not(:first-child)');

    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const filter = btn.dataset.filter;

            rows.forEach(row => {
                const type = row.children[1].textContent.trim().toUpperCase();

                if (filter === "all") {
                    row.style.display = "";
                } 
                else if (filter === "cash") {
                    row.style.display = (type === "DEPOSIT" || type === "WITHDRAW") ? "" : "none";
                } 
                else if (filter === "invest") {
                    row.style.display = (type === "BUY" || type === "SELL") ? "" : "none";
                }
            });
        });
    });

});
</script>

</body>
</html>