<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/assets/style.css">
    <title>Titan Invest | Terminal</title>
</head>

<body class="auth-page">

<nav class="top-nav">
    <a href="/investments/investmentsfrontend">Investments Dashboard</a>
    <a href="/cash/history">Transaction History</a>
    <a href="/capitalgains/summary">Capital Gains</a>
    <a href="/logout">Logout</a>
</nav>

<section id="summary" class="auth-form">
    <h2>Welcome {{name}}</h2>

    <p><strong>Cash Balance:</strong> £<span id="cash-balance">{{balance}}</span></p>

    <div class="action-row">
        <a class="btn" href="/cash/deposit-page">Deposit</a>
        <a class="btn" href="/cash/withdraw-page">Withdraw</a>
    </div>
</section>

{{#if error}}
<script>
    (function(){
        try {
            var decoded = decodeURIComponent('{{error}}');
            if (decoded) {
                alert(decoded);
                try {
                    var url = new URL(window.location.href);
                    url.searchParams.delete('error');
                    var clean = url.pathname + (url.searchParams.toString() ? ('?' + url.searchParams.toString()) : '');
                    history.replaceState(null, '', clean);
                } catch (ex) { }
            }
        } catch (e) {
            try { alert('{{error}}'); } catch (e2) { }
        }
    })();
</script>
{{/if}}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const balanceEl = document.getElementById('cash-balance');
        if (balanceEl) {
            const raw = balanceEl.textContent && balanceEl.textContent.trim();
            const pence = parseInt(raw || '0', 10) || 0;
            balanceEl.textContent = (pence / 100).toFixed(2);
        }
    });
</script>

</body>
</html>