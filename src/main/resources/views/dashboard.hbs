<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Scotbank | Portfolio Categorization</title>
    <link rel="stylesheet" href="/assets/style.css"> <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { background-color: #0d1117; color: white; font-family: 'Segoe UI', sans-serif; }
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }

        /* The Card Style from your Login Page */
        .card {
            background-color: #161b22;
            border: 1px solid #30363d;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.5);
            margin-bottom: 20px;
        }

        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        .blue-btn { background-color: #448aff; color: white; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; }

        /* Tab Navigation */
        .tabs { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid #30363d; padding-bottom: 10px; }
        .tab-btn { background: none; border: none; color: #8b949e; cursor: pointer; font-size: 16px; padding: 10px; }
        .tab-btn.active { color: #448aff; border-bottom: 2px solid #448aff; }

        .chart-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th { text-align: left; color: #8b949e; padding: 12px; border-bottom: 1px solid #30363d; }
        td { padding: 12px; border-bottom: 1px solid #21262d; }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1>Welcome, {{user}}</h1>
        <div class="total-value">Total Portfolio: <strong>£{{totalValue}}</strong></div>
    </div>

    <div class="card">
        <div class="tabs">
            <button class="tab-btn active" onclick="showChart('industry')">Industry</button>
            <button class="tab-btn" onclick="showChart('region')">Region</button>
            <button class="tab-btn" onclick="showChart('country')">Country</button>
        </div>

        <div class="chart-grid">
            <div style="max-width: 400px;">
                <canvas id="portfolioChart"></canvas>
            </div>

            <div>
                <h3>Holdings Details</h3>
                <table>
                    <thead>
                    <tr>
                        <th>Ticker</th>
                        <th>Name</th>
                        <th>Sector</th>
                        <th>Market Cap</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#each equities}}
                        <tr>
                            <td style="color: #448aff;">{{ticker}}</td>
                            <td>{{name}}</td>
                            <td>{{sector}}</td>
                            <td>£{{marketCap}}</td>
                        </tr>
                    {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    // Data passed from your Java Controller
    const industryData = {
        labels: [{{#each industries}}'{{label}}',{{/each}}],
        values: [{{#each industries}}{{totalValue}},{{/each}}]
    };

    const regionData = {
        labels: [{{#each regions}}'{{label}}',{{/each}}],
        values: [{{#each regions}}{{totalValue}},{{/each}}]
    };

    const ctx = document.getElementById('portfolioChart').getContext('2d');
    let myChart = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: industryData.labels,
            datasets: [{
                data: industryData.values,
                backgroundColor: ['#448aff', '#00e676', '#ffea00', '#ff9100', '#f50057', '#d500f9', '#30363d'],
                borderWidth: 0
            }]
        },
        options: {
            plugins: {
                legend: { position: 'bottom', labels: { color: 'white' } }
            }
        }
    });

    function showChart(type) {
        // Logic to update chart labels/data based on tab click
        // To keep it simple for your 3hr deadline, focus on the default Industry view first!
    }
</script>

</body>
</html>